* text=auto eol=lf

# C# / JSON / Markdown / JS 统一按文本处理
*.cs        text diff=csharp
*.csproj    text
*.json      text
*.md        text
*.mjs       text
*.js        text
*.css       text
*.html      text
*.yml       text
*.yaml      text
*.sh        text eol=lf
*.ps1       text eol=crlf

# 二进制：不做行尾转换，也不要在 diff 里显示内容
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.dll       binary
*.exe       binary
*.pdb       binary

# 语言统计时把文档排除在外（GitHub 语言占比更准确）
docs/**     linguist-documentation
*.md        linguist-documentation
