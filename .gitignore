# ---------------------------------------------------------------
# 构建产物（dotnet build 会自动重建，不要提交）
# ---------------------------------------------------------------
[Bb]in/
[Oo]bj/
*.user
*.suo
*.userosscache
*.sln.docstates
*.pdb
*.dll
*.exe
!*.exe.config

# ---------------------------------------------------------------
# IDE / 编辑器
# ---------------------------------------------------------------
.vs/
.vscode/
.idea/
*.swp
*~
*.DotSettings.user

# ---------------------------------------------------------------
# 运行期数据：JSON 数据库、工作区、快照、审计、密钥、出站箱
# 这些目录里含有口令哈希、加密后的用户原始输入与审计链，
# 绝对不允许提交。默认位置是 App_Data，可用 AISERVER_DATA_ROOT 改。
# ---------------------------------------------------------------
App_Data/
**/App_Data/
secrets.json
*.jsonl
audit.jsonl
outbox/
blobs/
versions.json

# 本地配置覆盖（把真实密钥写在这里，不要写 appsettings.json）
appsettings.Local.json
appsettings.*.Local.json
appsettings.Development.json
.env
.env.*
!.env.example

# ---------------------------------------------------------------
# 测试与调试残留（各验收套件的独立数据根 / 日志）
# ---------------------------------------------------------------
_*/
_*.log
*.log
*.err
*.out
*.tmp
*.bak
!**/*.md.bak

# ---------------------------------------------------------------
# Node（仅测试脚本使用，无依赖，忽略以防万一）
# ---------------------------------------------------------------
node_modules/
npm-debug.log*
package-lock.json

# ---------------------------------------------------------------
# 操作系统杂项
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
