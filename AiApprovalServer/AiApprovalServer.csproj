<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AiApproval</RootNamespace>
    <AssemblyName>AiApprovalServer</AssemblyName>
    <!-- 关闭全局化以缩小运行时依赖，本服务只输出/解析 UTF-8 与固定数字格式 -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 开源仓库元信息 -->
    <Version>1.0.0</Version>
    <Authors>星涵</Authors>
    <Company>星云游</Company>
    <Product>AI Agent 安全执行与审批平台</Product>
    <Description>企业级 AI Agent 安全执行与审批系统：规则引擎硬拦截 + AI 安全审核物理隔离 + 人工审批 + 快照回退 + 审计哈希链</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/xingyungames/agent-safe-gate</RepositoryUrl>
    <!--
      发布约定：前端（wwwroot）与 appsettings.json 必须保持为**松散文件**，
      部署后可以直接在服务器上改，不需要重新编译。因此禁止单文件/裁剪发布：
        PublishSingleFile=false （不把资源打进可执行文件）
        PublishTrimmed=false    （不裁剪，避免反射与静态资源探测失效）
    -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <PackageProjectUrl>https://github.com/xingyungames/agent-safe-gate</PackageProjectUrl>
  </PropertyGroup>

  <!--
    本服务刻意不引入任何第三方包：
      * JWT 采用自实现的 HMAC-SHA256 紧凑序列化（避免引入 Microsoft.IdentityModel.* 的版本与算法混淆风险）
      * 密码采用 PBKDF2-HMAC-SHA256，敏感字段采用 AES-256-GCM
      * JSON 存储采用 System.Text.Json
    依赖越少，可审计面积越小。
  -->

  <!-- 让构建输出目录直接可运行（wwwroot 一并复制，不必先 publish 才能起页面） -->
  <ItemGroup>
    <Content Update="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    真实密钥文件绝不进构建与发布产物：
      config/ 下的 json 会被 Web SDK 默认当作 Content 复制到 bin/ 与 publish/，
      于是"把一个发布包交给别人"就等于把飞书凭证和初始超管口令哈希一起交出去。
      这里显式禁止复制真实文件、只放行模板；运行时由 AppConfig 自己定位该文件
      （内容根下的 config/ → 向上层目录找项目里的那一份 → AISERVER_SECRETS_FILE 指定路径）。
  -->
  <ItemGroup>
    <Content Update="config/secrets.local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="secrets.local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="config/secrets.local.example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
