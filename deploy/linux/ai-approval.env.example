# /etc/ai-approval/ai-approval.env
# 权限必须是 0600，属主 ai-approval；本文件由 systemd 的 EnvironmentFile 注入。
# 生成密钥：openssl rand -base64 48  →  JWT
#           openssl rand -base64 32  →  AES（必须是 32 字节 base64）
#           openssl rand -base64 24  →  pepper

# ---- 监听与数据目录 ---------------------------------------------------------
# 只监听回环；对外一律经 nginx 终止 TLS 后转发。不要改成 0.0.0.0。
AISERVER_LISTEN_URL=http://127.0.0.1:8899
# 落盘目录（users.json / tasks.json / audit.jsonl / blobs ...），单独备份
AISERVER_DATA_ROOT=/var/lib/ai-approval

# ---- 服务端密钥（生产必须来自环境变量）--------------------------------------
AISERVER_JWT_SECRET=
AISERVER_AES_KEY=
AISERVER_PEPPER=

# ---- AI ---------------------------------------------------------------------
# 留空 = 降级模式（本地意图解析 + 变更类操作全部转人工），系统仍完整可用
AISERVER_AI_KEY=
# 只有用自建网关时才需要（默认白名单 api.deepseek.com，且公网必须 https）
# AISERVER_AI_ALLOWED_HOSTS=api.deepseek.com

# ---- 反向代理 / 来源校验 ----------------------------------------------------
# 浏览器实际访问的来源，必须带协议、不支持通配符；多个用分号或逗号分隔。
# 漏了这一项：登录等写请求会被 403 BAD_ORIGIN 拦下。
AISERVER_TRUSTED_ORIGINS=https://ops.example.com

# 可信代理：只有 TCP 对端就是这些 IP 时才采信 X-Client-Ip。
# 本机 nginx 与网关都在 127.0.0.1，且 nginx 会把客户端自带的 X-Client-Ip 透传进来，
# 所以这里保持为空（宁可按对端地址算 IP，也不要引入可伪造的来源）。
# 只有当你能确保代理侧删掉该头时，才改成 127.0.0.1 以获得真实用户 IP。
AISERVER_TRUSTED_PROXIES=

# ---- 飞书（主服务器侧只用于报销单写入与账号镜像）----------------------------
# 注意变量名是大写拼接、没有下划线：AISERVER_FEISHU_APPID / APPSECRET / APPTOKEN / TABLEID / USERTABLEID
# AISERVER_FEISHU_APPID=
# AISERVER_FEISHU_APPSECRET=
# AISERVER_FEISHU_APPTOKEN=
# AISERVER_FEISHU_TABLEID=
# AISERVER_FEISHU_USERTABLEID=

# ---- 初始超级管理员（可选）--------------------------------------------------
# 口令只给哈希：node AiApprovalServer/Tools/hash-password.mjs "<口令>"
# AISERVER_BOOTSTRAP_USERNAME=
# AISERVER_BOOTSTRAP_DISPLAYNAME=
# AISERVER_BOOTSTRAP_PASSWORDHASH=
# AISERVER_BOOTSTRAP_PASSWORDSALT=
# AISERVER_BOOTSTRAP_PASSWORDITERATIONS=210000

# ---- 其它常用旋钮（默认值即可）----------------------------------------------
# AISERVER_PASSWORD_ITERATIONS=1200000
# AISERVER_INVOICE_AI_ENABLED=true
# 生产想"密钥缺失就拒绝启动"：先删掉 $AISERVER_DATA_ROOT/secrets.json，
# 再在 appsettings.json 里把 Security:StrictSecrets 设为 true
