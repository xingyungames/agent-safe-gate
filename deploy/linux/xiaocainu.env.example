# /etc/ai-approval/xiaocainu.env
# 权限 0600，属主 ai-approval。由 systemd EnvironmentFile 注入；
# 环境变量优先级高于应用目录里的 .env（网关的 .env 加载器不会覆盖已存在的环境变量）。
# 因此服务器上不必再放 xiaocainu/.env，密钥只留在这一个 0600 文件里。

# ---- 主服务器（必填）--------------------------------------------------------
# 留空 = 网关拒绝服务（账号与权限只在主服务器那一侧）。
# 注意：BACKEND_MODE 已从代码中删除，不要再照抄旧的 preferred / required。
BACKEND_BASE_URL=http://127.0.0.1:8899
BACKEND_TIMEOUT=30

# ---- 大模型（对话解析 + 发票 OCR）-------------------------------------------
# ollama = 本机免费模型；deepseek / agnes = 云端按量计费
LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 本机 Ollama（LLM_PROVIDER=ollama 时使用；注意 systemd 下 localhost 指本机）
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_API_KEY=ollama
# OLLAMA_MODEL=qwen2.5:7b

# Agnes 云端
# AGNES_BASE_URL=https://api.agnes-ai.cn/v1
# AGNES_API_KEY=
# AGNES_MODEL=agnes-2.5-flash

# ---- 发票 OCR（默认复用 DeepSeek 凭证）-------------------------------------
# 留空即复用 DEEPSEEK_*；单张图片上限决定 nginx client_max_body_size
OCR_BASE_URL=https://api.deepseek.com
OCR_MODEL=deepseek-flash
OCR_DETAIL=high
OCR_MAX_IMAGE_MB=8

# ---- 飞书（网关侧只用于上传发票附件）--------------------------------------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
FEISHU_TABLE_ID=

# ---- 网关侧登录失败限流（主服务器另有自己的限流）--------------------------
AUTH_LOGIN_LIMIT=5
AUTH_LOGIN_WINDOW=300
