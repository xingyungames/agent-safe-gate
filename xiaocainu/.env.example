# M1 LLM 适配器配置
# 复制本文件为 .env 后填写；.env 切勿提交到源码仓库

# 选择 provider: ollama(默认,本地免费) 或 deepseek(云端,按量计费)
LLM_PROVIDER=ollama

# 本地 Ollama（OpenAI 兼容接口，默认 http://localhost:11434/v1）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:7b

# 云端 DeepSeek-V3（仅当 LLM_PROVIDER=deepseek 时使用，注意按次计费）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=你的密钥_勿提交
DEEPSEEK_MODEL=deepseek-flash

# M9 发票 OCR（默认复用上面的 DeepSeek 凭证；deepseek-flash 原生支持图片输入）
# OCR_BASE_URL=https://api.deepseek.com
# OCR_API_KEY=留空则回落 DEEPSEEK_API_KEY
# OCR_MODEL=deepseek-flash
# OCR_DETAIL=high
# OCR_MAX_IMAGE_MB=8

# 云端 Agnes 2.5 Flash（仅当 LLM_PROVIDER=agnes 时使用，注意按量计费）
# 关键：必须用 agnes-2.5-flash（agnes-2.0-flash 已废弃，调用会报 No available channel）
AGNES_BASE_URL=https://api.agnes-ai.cn/v1
AGNES_API_KEY=你的密钥_勿提交
AGNES_MODEL=agnes-2.5-flash

# M3 飞书 Bitable 配置（凭证外置，勿提交真实值）
# app_id / app_secret 来自飞书开放平台自建应用
FEISHU_APP_ID=你的飞书_app_id_勿提交
FEISHU_APP_SECRET=你的飞书_app_secret_勿提交
# 多维表格 base id（即 app_token）；主表 table_id 在代码/配置中指定
FEISHU_APP_TOKEN=你的多维表格_base_id_勿提交
# 主表 table_id（报销单主表，例：tbl5Dz4SdKmmwgP5；新版企业级 17 字段表建好后换成新表 id）
FEISHU_TABLE_ID=tbl5Dz4SdKmmwgP5

# M8 账号系统（详见 docs/TABLE_SETUP.md）
# 用户表 table_id（角色/密码哈希存这张表）
FEISHU_USER_TABLE_ID=你的用户表_table_id_勿提交
# 认证密钥（HMAC 签名 token 用；生成：python -c "import secrets;print(secrets.token_hex(32))"）
AUTH_SECRET=你的随机密钥_勿提交
# token 有效期（秒，默认 7200=2小时）
AUTH_TOKEN_TTL=7200
# 登录限流：窗口内最大失败尝试次数 / 窗口秒数（默认 5 次/300 秒）
AUTH_LOGIN_LIMIT=5
AUTH_LOGIN_WINDOW=300

# 主服务器 AiApprovalServer（财务写操作唯一入口：账号权威 / 权限矩阵 / 快照回退 / 审计哈希链）
# 地址留空 = 不启用主服务器（此时财务写操作返回 503，不回落直连飞书）
BACKEND_BASE_URL=http://127.0.0.1:8899
# 模式：preferred = 连不上时登录用本地飞书用户表兜底；required = 连不上直接 503（生产建议）
BACKEND_MODE=preferred
# 单次调用超时（秒）
BACKEND_TIMEOUT=15
